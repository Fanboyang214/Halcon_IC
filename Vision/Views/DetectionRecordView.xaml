<UserControl x:Class="Vision.Views.DetectionRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="360"
             Background="White">
    <Grid Margin="4">
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  FontSize="10" RowHeight="22" Background="White"
                  ItemsSource="{Binding Records}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70"/>
                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="50"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="50"/>
                <DataGridTextColumn Header="Pin1" Binding="{Binding Pin1}" Width="40"/>
                <DataGridTextColumn Header="Pin2" Binding="{Binding Pin2}" Width="40"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
