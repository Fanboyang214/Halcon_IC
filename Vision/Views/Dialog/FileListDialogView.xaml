<UserControl x:Class="Vision.Views.Dialog.FileListDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Vision.Views.Dialog"
             mc:Ignorable="d" 
            
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="450" Width="650"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <Style x:Key="FileListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFE0E8F0"/>
                                <Setter Property="BorderBrush" Value="#FF007ACC"/>
                                <Setter Property="BorderThickness" Value="1,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0F0F0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="选择文件" 
                   FontSize="18" 
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- 路径显示和搜索栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="搜索文件名..."
                     Height="32"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <!-- 文件列表 -->
        <ListBox Grid.Row="2" 
                 Style="{StaticResource FileListStyle}"
                 ItemsSource="{Binding FileItems}"
                 SelectedItem="{Binding SelectedFile}"
                 MouseDoubleClick="ListBox_MouseDoubleClick">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" 
                                       FontSize="13"
                                       Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding Extension}" 
                                       Foreground="Gray"
                                       FontSize="11"
                                       Margin="5,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SizeDisplay}"
                                   Foreground="Gray"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2" 
                                   Text="{Binding ModifiedTimeDisplay}"
                                   Foreground="Gray"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Foreground="Gray" FontSize="12">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="共 {0} 个文件">
                            <Binding Path="FileItems.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{Binding SelectedFile.FileName, StringFormat=' | 已选: {0}'}" 
                           Foreground="#FF007ACC" 
                           FontSize="12"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="取消" 
                    Command="{Binding CancelCommand}"
                    Width="80" Height="32"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2" 
                    Content="确认" 
                    Command="{Binding ConfirmCommand}"
                    Width="80" Height="32"
                    IsDefault="True"/>
        </Grid>

        <!-- 加载遮罩 -->
        <Border Grid.RowSpan="4" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#CCFFFFFF">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" Height="10"/>
                <TextBlock Text="正在加载文件..." 
                           Margin="0,10,0,0"
                           FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
