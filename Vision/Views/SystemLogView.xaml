<UserControl x:Class="Vision.Views.SystemLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:bh ="clr-namespace:Vision.Behaviors"
             xmlns:i ="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             mc:Ignorable="d"
             
             d:DesignHeight="200" d:DesignWidth="360"
             Background="White">
    
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4">
            <Button Content="清空" Command="{Binding LogClearCommand}" FontSize="10" Padding="6,2" Margin="0,0,6,0"/>
            <CheckBox Content="自动滚动" IsChecked="{Binding IsAutoScroll}" FontSize="10" VerticalAlignment="Center"/>
        </StackPanel>
        <ListBox
         ItemsSource="{Binding LogRecords}"
         VirtualizingStackPanel.IsVirtualizing="True"
         VirtualizingStackPanel.VirtualizationMode="Recycling"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         ScrollViewer.CanContentScroll="True"   
         VirtualizingStackPanel.ScrollUnit="Pixel" Grid.Row="1" Background="Black"
         
         
            d:ItemsSource="{d:SampleData ItemCount=10}">
            <i:Interaction.Behaviors>
                <bh:ListBoxAutoScrollBehavior IsAutoScroll="{Binding IsAutoScroll}"/>
            </i:Interaction.Behaviors>
            <!-- WPF 4.5+ 按像素滚动 -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <!-- 时间 -->
                            <ColumnDefinition Width="52"/>
                            <!-- 级别 -->
                            <ColumnDefinition Width="*"/>
                            <!-- 消息 -->
                        </Grid.ColumnDefinitions>

                        <!-- 时间戳 -->
                        <TextBlock Grid.Column="0"
                       Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                       FontFamily="Consolas" FontSize="10"
                       Foreground="#888888" Margin="0,0,6,0"/>

                        <!-- 级别（按 LevelColor 着色） -->
                        <TextBlock Grid.Column="1"
                       Text="{Binding Level}"
                       FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                       Foreground="{Binding LevelColor}"
                       Margin="0,0,6,0"/>

                        <!-- 消息正文 -->
                        <TextBlock Grid.Column="2"
                       Text="{Binding Message}"
                       FontFamily="Consolas" FontSize="10"
                       Foreground="LightGray"
                       TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--<TextBox Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontSize="10" FontFamily="Consolas"
                 Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                 BorderThickness="0" Padding="6" Text="系统日志就绪...&#10;等待操作..."/>-->
    </Grid>
</UserControl>
