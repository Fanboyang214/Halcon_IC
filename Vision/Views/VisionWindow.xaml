<UserControl x:Class="Vision.Views.VisionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=HalconDotNet"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="打开相机" Command="{Binding OpenCameraCmd}" Margin="2" Padding="8,2"/>
            <Button Content="关闭相机" Command="{Binding CloseCameraCmd}" Margin="2" Padding="8,2"/>
            <Separator/>
            <Button Content="开始采集" Command="{Binding StartGrabCmd}" Margin="2" Padding="8,2"/>
            <Button Content="停止采集" Command="{Binding StopGrabCmd}" Margin="2" Padding="8,2"/>
            <Separator/>
            <Button Content="加载参考图" Command="{Binding LoadReferenceImageCmd}" Margin="2" Padding="8,2"/>
            <Button Content="绘制ROI" Command="{Binding DrawRoiCmd}" Margin="2" Padding="8,2"/>
            <Button Content="创建模板" Command="{Binding CreateTemplateCmd}" Margin="2" Padding="8,2"/>
            <Button Content="保存模板" Command="{Binding SaveTemplateCmd}" Margin="2" Padding="8,2"/>
            <Button Content="加载模板" Command="{Binding LoadTemplateCmd}" Margin="2" Padding="8,2"/>
            <Separator/>
            <Button Content="开始检测" Command="{Binding StartDetectCmd}" Margin="2" Padding="8,2"
                    Background="LightGreen"/>
            <Button Content="停止检测" Command="{Binding StopDetectCmd}" Margin="2" Padding="8,2"
                    Background="LightCoral"/>
        </WrapPanel>

        <!-- Halcon 图像窗口 -->
        <halcon:HSmartWindowControlWPF Grid.Row="1" x:Name="HalconWindow"
                                       Margin="0,0,0,4"
                                       HMoveContent="False"
                                       HZoomContent="Off"/>

        <!-- 状态栏 -->
        <Grid Grid.Row="2" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding ResultText}" VerticalAlignment="Center"
                       Margin="8,0" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                <Run Text="Score:"/><Run Text="{Binding MatchScore}"/>
            </TextBlock>
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                <Run Text="Pin1:"/><Run Text="{Binding PinCount}"/>
            </TextBlock>
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                <Run Text="Pin2:"/><Run Text="{Binding PinCount2}"/>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
