<Window x:Class="ICApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:conv="clr-namespace:ICApp.Converters"
        mc:Ignorable="d"
        Title="IC 视觉检测系统" Height="850" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBg" Color="#FF1A3A5C"/>
        <SolidColorBrush x:Key="HeaderText" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFF0F2F5"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD0D7DE"/>
        <SolidColorBrush x:Key="Accent" Color="#FF1E88E5"/>
        <SolidColorBrush x:Key="AccentLight" Color="#FFE3F2FD"/>
        <SolidColorBrush x:Key="OkColor" Color="#FF43A047"/>
        <SolidColorBrush x:Key="NgColor" Color="#FFE53935"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFFB8C00"/>
        <SolidColorBrush x:Key="FooterBg" Color="#FFE8ECF1"/>
        <SolidColorBrush x:Key="TitleBg" Color="#FF2C5282"/>
        <SolidColorBrush x:Key="SubTitleBg" Color="#FF3A6CB5"/>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource PanelBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ========== 顶部标题栏 ========== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="IC" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="视觉检测系统" Foreground="{StaticResource HeaderText}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource TitleBg}" CornerRadius="3" Padding="10,3">
                        <TextBlock Text="主界面" Foreground="{StaticResource HeaderText}" FontSize="12" Margin="0,0,12,0"/>
                    </Border>
                    <Border Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Accent}" CornerRadius="3" Padding="10,3" Margin="4,0,0,0">
                        <TextBlock Text="视觉检测" Foreground="{StaticResource Accent}" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="ClockText" Text="--:--:--" Foreground="{StaticResource HeaderText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </Grid>
        </Border>

        <!-- ========== 主体：左侧面板 + 中间图像 + 右侧面板 ========== -->
        <Grid Grid.Row="1" Background="{StaticResource PanelBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== 左侧面板（3 堆叠） ===================== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 运动控制 -->
                    <Border Grid.Row="0" Margin="6,6,6,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SubTitleBg}" CornerRadius="3,3,0,0" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="运动控制" Foreground="{StaticResource HeaderText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="MotionControlRegion" Background="{StaticResource CardBg}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"
                                            MinHeight="100"/>
                        </Grid>
                    </Border>
                    <!-- 系统日志 -->
                    <Border Grid.Row="1" Margin="6,3,6,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SubTitleBg}" CornerRadius="3,3,0,0" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="系统日志" Foreground="{StaticResource HeaderText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="SystemLogRegion" Height="200" Background="{StaticResource CardBg}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>
                    </Border>

                    <!-- 设备状态监测 -->
                    <Border Grid.Row="2" Margin="6,3,6,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SubTitleBg}" CornerRadius="3,3,0,0" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖥" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="设备状态监测" Foreground="{StaticResource HeaderText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="DeviceStatusRegion" Height="160" Background="{StaticResource CardBg}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>
                    </Border>
                    <!-- 模板模块 -->
                    

                    <!-- 检测模块 -->
                   
                </Grid>
            </Border>

            <!-- 左侧/中间分隔条 -->
            <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <!-- ===================== 中间图像显示区 ===================== -->
            <ContentControl Grid.Column="2" prism:RegionManager.RegionName="VisionRegion" Margin="4"/>

            <!-- 中间/右侧分隔条 -->
            <GridSplitter Grid.Column="3" Width="4" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <!-- ===================== 右侧面板（4 堆叠） ===================== -->
            <Border Grid.Column="4" Background="{StaticResource PanelBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 检测数据趋势 -->
                    <Border Grid.Row="0" Margin="6,6,6,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SubTitleBg}" CornerRadius="3,3,0,0" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="检测数据趋势" Foreground="{StaticResource HeaderText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="StatisticRegion" Height="230" Background="{StaticResource CardBg}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>
                    </Border>

                   

                    <!-- 实时检测记录 -->
                    <Border Grid.Row="2" Margin="6,3,6,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource SubTitleBg}" CornerRadius="3,3,0,0" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="实时检测记录" Foreground="{StaticResource HeaderText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" prism:RegionManager.RegionName="DetectionRecordRegion" Background="{StaticResource CardBg}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"/>
                        </Grid>
                    </Border>

                    
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 底部状态栏 ========== -->
        <Border Grid.Row="2" Background="{StaticResource FooterBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource OkColor}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="系统正常" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="就绪" FontSize="11" Foreground="#FF666666" VerticalAlignment="Center" Margin="20,0"/>
                <TextBlock Grid.Column="2" Text="就绪" FontSize="11" Foreground="#FF888888" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="3" Text="v1.0.0" FontSize="11" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="4" Text="© 2026 IC Vision" FontSize="11" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
