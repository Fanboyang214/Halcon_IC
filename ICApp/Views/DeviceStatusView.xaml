<UserControl x:Class="ICApp.Views.DeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="360"
             Background="White">
    <Grid Margin="8">
        <StackPanel>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="相机" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Vision.CameraStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Vision.CameraStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vision.CameraStatus}" Value="0">
                                        <Setter Property="Text" Value="已连接"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Vision.CameraStatus}" Value="1">
                                        <Setter Property="Text" Value="未连接"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Vision.CameraStatus}" Value="2">
                                        <Setter Property="Text" Value="连接失败"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="模板" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Vision.TemplateStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Vision.TemplateStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vision.TemplateStatus}" Value="0">
                                        <Setter Property="Text" Value="已创建"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Vision.TemplateStatus}" Value="1">
                                        <Setter Property="Text" Value="未创建"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Vision.TemplateStatus}" Value="2">
                                        <Setter Property="Text" Value="创建失败"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="检测" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Vision.DetectionStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Vision.DetectionStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Vision.DetectionStatus}" Value="0">
                                        <Setter Property="Text" Value="检测中"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Vision.DetectionStatus}" Value="1">
                                        <Setter Property="Text" Value="未检测"/>
                                    </DataTrigger>


                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="运动控制卡" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Motion.ConnectStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Motion.ConnectStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Motion.ConnectStatus}" Value="0">
                                        <Setter Property="Text" Value="已连接"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.ConnectStatus}" Value="1">
                                        <Setter Property="Text" Value="未连接"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.ConnectStatus}" Value="2">
                                        <Setter Property="Text" Value="连接失败"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="电机" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Motion.SevonStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Motion.SevonStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Motion.SevonStatus}" Value="0">
                                        <Setter Property="Text" Value="已使能"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.SevonStatus}" Value="1">
                                        <Setter Property="Text" Value="未使能"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="传送带" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Motion.MoveStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Motion.MoveStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Motion.MoveStatus}" Value="0">
                                        <Setter Property="Text" Value="已启动"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.MoveStatus}" Value="1">
                                        <Setter Property="Text" Value="未启动"/>
                                    </DataTrigger>


                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="推料机构" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Solenoid.solenoidStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Solenoid.solenoidStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Solenoid.solenoidStatus}" Value="0">
                                        <Setter Property="Text" Value="已触发"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Solenoid.solenoidStatus}" Value="1">
                                        <Setter Property="Text" Value="未触发"/>
                                    </DataTrigger>


                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26*"/>
                    <ColumnDefinition Width="57*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="传感器" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding SensorStatus.SensorStatue, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding SensorStatus.SensorStatue, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SensorStatus.SensorStatue}" Value="0">
                                        <Setter Property="Text" Value="传感器触发"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SensorStatus.SensorStatue}" Value="1">
                                        <Setter Property="Text" Value="传感器常态"/>
                                    </DataTrigger>


                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="检查结果" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Motion.MoveStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Motion.MoveStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Motion.MoveStatus}" Value="0">
                                        <Setter Property="Text" Value="OK"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.MoveStatus}" Value="1">
                                        <Setter Property="Text" Value="NG"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.MoveStatus}" Value="2">
                                        <Setter Property="Text" Value="NotFound"/>
                                    </DataTrigger>


                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
