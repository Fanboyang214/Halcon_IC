<UserControl x:Class="ICApp.Views.DeviceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="360"
             Background="White">
    <Grid Margin="8">
        <StackPanel>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="相机" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FF43A047" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="已连接" FontSize="10" Foreground="#FF43A047" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="模板" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FFBDBDBD" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="未创建" FontSize="10" Foreground="#FF888888" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="检测" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FFBDBDBD" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="空闲" FontSize="10" Foreground="#FF888888" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="运动控制卡" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Motion.ConnectStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Motion.ConnectStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Motion.ConnectStatus}" Value="0">
                                        <Setter Property="Text" Value="已连接"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.ConnectStatus}" Value="1">
                                        <Setter Property="Text" Value="未连接"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.ConnectStatus}" Value="2">
                                        <Setter Property="Text" Value="连接失败"/>
                                    </DataTrigger>
                                    
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="电机" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Motion.SevonStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Motion.SevonStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Motion.SevonStatus}" Value="0">
                                        <Setter Property="Text" Value="已使能"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.SevonStatus}" Value="1">
                                        <Setter Property="Text" Value="未使能"/>
                                    </DataTrigger>
                                  
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="传送带" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding Motion.MoveStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock  FontSize="10" Foreground="{Binding Motion.MoveStatus, Converter={StaticResource IntToColorConverter}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Motion.MoveStatus}" Value="0">
                                        <Setter Property="Text" Value="已启动"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Motion.MoveStatus}" Value="1">
                                        <Setter Property="Text" Value="未启动"/>
                                    </DataTrigger>
                                    

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="推料机构" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FFFB8C00" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="就绪" FontSize="10" Foreground="#FFFB8C00" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="传感器" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FFFB8C00" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="就绪" FontSize="10" Foreground="#FFFB8C00" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="检查结果" FontSize="11" Foreground="#FF555555" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FFFB8C00" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="就绪" FontSize="10" Foreground="#FFFB8C00" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
